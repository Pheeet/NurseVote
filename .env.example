# Copy to .env and fill in real values. See README for full setup.
# Neon Postgres connection string
DATABASE_URL=postgres://user:password@host/db?sslmode=require
# Shared secret for admin endpoints (x-admin-key header)
ADMIN_KEY=change-me
# Google OAuth Web Client ID — both vars must be the SAME id.
# Create at Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web).
# Authorized JavaScript origins: http://localhost:5173 + production domain.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Frontend copy (exposed to the browser by Vite via import.meta.env)
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
